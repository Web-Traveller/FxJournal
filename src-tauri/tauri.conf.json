{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FxJournal",
  "version": "0.1.0",
  "identifier": "com.fxjournal.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FxJournal — Desktop Forex Trading Journal",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzN0MyOTI0NjQxMzUwNTMKUldSVFVCTmtKQ2w4OHdYWlNaaTVXUm4vUThQV25KVlZqM3poei9RNUNpZ0RFWXhBSEdyNlMyc1IK",
      "endpoints": [
        "https://github.com/Web-Traveller/FxJournal/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
